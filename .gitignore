# build output
dist/
.astro/

# deps
# Both patterns matter: the trailing-slash form only matches directories, so a
# `node_modules` SYMLINK (which is what a git worktree needs to reach the real
# install) would otherwise be committed — and a self-referential symlink then
# destroys the real directory on checkout. This happened twice.
node_modules
node_modules/

# env / credentials — Phase B (§18.4). Never commit real keys.
.env
.env.*
!.env.example
.dev.vars

# résumé is a drop-in (§13); Dylan's real PDF is not tracked
public/resume.pdf

# NOTE: public/og/paper.png IS tracked on purpose. It is generated by
# scripts/make-og.sh via macOS `sips`, which does not exist on Cloudflare's Linux
# build image — so it has to be committed rather than built at deploy time.

# os / editor
.DS_Store
*.log
npm-debug.log*
.vscode/*
!.vscode/extensions.json
.idea/

# NOTE: assets-src/ IS tracked on purpose. It holds the only surviving copies of
# the eight carried-over assets — github.com is off the sandbox allowlist and
# they cannot be re-fetched (§18.2). Do not add it here.

# Agent worktrees (transient; each is its own git checkout)
.claude/worktrees/

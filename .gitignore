# build output
dist/
.astro/

# deps
# Both patterns matter: the trailing-slash form only matches directories, so a
# `node_modules` symlink slips through it — and committing one destroys the real
# directory on checkout. Keep both lines.
node_modules
node_modules/

# env / credentials — never commit real keys
.env
.env.*
!.env.example
.dev.vars

# public/resume.pdf IS tracked on purpose: getResume() checks for the file at
# build time, and GitHub Actions builds from a clean checkout — an untracked PDF
# is present locally and absent live, which is the worst of both. Replacing it
# keeps the same filename; /resume.pdf is cached for an hour in public/_headers
# so a swap goes out quickly.

# public/og/card.png IS tracked on purpose: scripts/make-og.sh builds it with
# macOS `sips`, which does not exist on the Linux runner GitHub Actions builds on.

# assets-src/ IS tracked on purpose — it holds the only copies of the source
# artwork the shipped WebPs are generated from. Do not add it here.

# os / editor
.DS_Store
*.log
npm-debug.log*
.vscode/*
!.vscode/extensions.json
.idea/

# editor/assistant scratch space
.claude/

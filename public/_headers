# Cloudflare Pages headers. Copied verbatim from public/ into dist/ at build time.
#
# Kept minimal on purpose (§18.4: no deploy config beyond the Pages build script).
# These are static-hosting concerns only — nothing here depends on an account.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Astro fingerprints these filenames, so they can be cached indefinitely.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Media filenames are stable rather than hashed, so revalidate daily. The heavy
# animated WebPs are only fetched on user intent (see MotionMedia), which matters
# more here than the cache policy.
/media/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/og/*
  Cache-Control: public, max-age=86400

/favicon.ico
  Cache-Control: public, max-age=604800
/favicon-16.png
  Cache-Control: public, max-age=604800
/favicon-32.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800

# The résumé is replaced without a filename change, so don't cache it hard.
/resume.pdf
  Cache-Control: public, max-age=3600

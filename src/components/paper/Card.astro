---
/**
 * A pinned card — the primitive the whole board is built from.
 *
 * Rotation comes from the CSS custom property so print and reduced-motion can
 * flatten every card at once. Pins/tape are decoration and are marked
 * data-decorative so the print stylesheet strips them.
 */
type Props = {
  /** Which tilt to use. */
  tilt?: 'a' | 'b' | 'c' | 'flat';
  /** Pin position, or none. */
  pin?: 'center' | 'left' | 'right' | 'none';
  pinColor?: 'red' | 'sage' | 'sky';
  /** Tape corners to apply. */
  tape?: Array<'tl' | 'tr' | 'bl' | 'br'>;
  tapeColor?: 'sage' | 'blush' | 'butter' | 'sky';
  /** Adds a halftone plate behind the content. */
  halftone?: false | 'sage' | 'blush' | 'butter' | 'sky';
  /** Torn bottom edge. */
  deckle?: boolean;
  class?: string;
  style?: string;
};

const {
  tilt = 'a',
  pin = 'center',
  pinColor = 'red',
  tape = [],
  tapeColor = 'sage',
  halftone = false,
  deckle = false,
  class: className = '',
  style,
} = Astro.props;

const inkVar = {
  sage: 'var(--ink-sage)',
  blush: 'var(--ink-blush)',
  butter: 'var(--ink-butter)',
  sky: 'var(--ink-sky)',
};

const classes = [
  'card',
  tilt !== 'a' ? `card--tilt-${tilt}` : '',
  halftone ? 'halftone' : '',
  deckle ? 'deckle' : '',
  className,
]
  .filter(Boolean)
  .join(' ');

const styles = [halftone ? `--halftone-ink:${inkVar[halftone]}` : '', style]
  .filter(Boolean)
  .join(';');
---

<div class={classes} style={styles || undefined} data-print-block>
  {pin !== 'none' && (
    <span
      class={`pin ${pinColor !== 'red' ? `pin--${pinColor}` : ''} ${pin !== 'center' ? `pin--${pin}` : ''}`}
      data-decorative
      aria-hidden="true"
    />
  )}
  {
    tape.map((corner) => (
      <span
        class={`tape tape--${corner} ${tapeColor !== 'sage' ? `tape--${tapeColor}` : ''}`}
        data-decorative
        aria-hidden="true"
      />
    ))
  }
  <slot />
</div>

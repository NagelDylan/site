---
/**
 * Paper theme layout: header, pinned-index-card nav, footer.
 *
 * Everything a recruiter needs in the first 20 seconds is in the static HTML
 * here or on the page itself — never behind an interaction (§9 usability rule).
 * The only island in the chrome is the control cluster.
 */
import '@fontsource-variable/newsreader';
import '@fontsource/caveat/600.css';
import '@fontsource/caveat/700.css';
import '../../styles/theme-paper.css';

import SiteShell from '../../layouts/SiteShell.astro';
import PaperControls from './PaperControls.tsx';
import { IDENTITY, SOCIALS } from '../../data/identity';
import { getResume } from '../../lib/resume';

type Props = {
  title: string;
  description?: string;
  path?: string;
  /** Passed through to SiteShell → BaseHead. /resume uses it for its empty state. */
  noIndex?: boolean;
  /** Adds the page-turn animation — project detail pages only (§9). */
  pageTurn?: boolean;
};

const { pageTurn = false, ...head } = Astro.props;
const here = Astro.url.pathname.replace(/\/$/, '') || '/';

/*
 * The nav is BUILT here rather than declared at module scope, because the Résumé
 * entry is conditional: a nav link to a page with no document on it is worse than
 * no nav link at all — it promises a file and delivers an apology, which is
 * exactly what §18.5 forbids. /resume still exists and still renders in both
 * states (deep links and bookmarks have to resolve to something), but it is only
 * *advertised* once there is something there.
 *
 * Same file-is-the-switch property as every other résumé surface: getResume()
 * checks for public/resume.pdf at build time, so dropping the PDF in lights this
 * link up along with the buttons, with no code change.
 *
 * Order is Home, Experience, Projects, Résumé, About, Contact — the résumé sits
 * with the other things a recruiter is scanning for, not filed under About.
 */
const resume = getResume();

const NAV = [
  { href: '/', label: 'Home' },
  { href: '/experience', label: 'Experience' },
  { href: '/projects', label: 'Projects' },
  ...(resume.available ? [{ href: resume.page, label: 'Résumé' }] : []),
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const year = new Date().getFullYear();
---

<SiteShell {...head}>
  <header class="paper-header">
    <div class="wrap" style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;">
      <a class="brand" href="/">
        <span aria-hidden="true">✎</span> {IDENTITY.name}
      </a>
      <nav class="nav-cards" aria-label="Main">
        {
          /*
            startsWith, so /projects/tanks still marks Projects as current. It is
            safe for /resume because no nav href is a prefix of another one — check
            that again before adding a route like /resume-old, which would light up
            two cards at once.
          */
          NAV.map((item) => (
            <a
              class="nav-card"
              href={item.href}
              aria-current={
                (item.href === '/' ? here === '/' : here.startsWith(item.href)) ? 'page' : undefined
              }
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      {/*
        client:load rather than client:visible — the switcher is the escape hatch
        from every theme (G8/G12) and must never be waiting on an intersection.
      */}
      <PaperControls initialMode="light" client:load />
    </div>
  </header>

  <main id="main" class={pageTurn ? 'page-turn' : undefined}>
    <slot />
  </main>

  <footer class="paper-footer">
    <div class="wrap">
      <hr class="stitch" data-decorative />
      <div class="footer-row">
        <span class="hand" style="font-size:1.25rem;">
          <span class="highlight highlight--sage">{IDENTITY.availabilityShort}</span>
        </span>
        <a href={SOCIALS.linkedin} rel="me noopener">LinkedIn</a>
        <a href={SOCIALS.github} rel="me noopener">GitHub</a>
        <a href={`mailto:${IDENTITY.email}`}>{IDENTITY.email}</a>
        <span style="margin-left:auto;" class="typewriter">© {year} {IDENTITY.name}</span>
      </div>
    </div>
  </footer>
</SiteShell>

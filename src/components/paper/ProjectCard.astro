---
/**
 * Featured project card for the board and the projects index.
 *
 * Shows the poster still only — the animation lives on the detail page, so the
 * index never pays for three animated files (G13).
 */
import Card from './Card.astro';
import type { Project } from '../../data/types';

type Props = {
  project: Project;
  blurb: string;
  tilt?: 'a' | 'b' | 'c';
  tapeColor?: 'sage' | 'blush' | 'butter' | 'sky';
};

const { project, blurb, tilt = 'a', tapeColor = 'butter' } = Astro.props;
---

<a class="project-card" href={`/projects/${project.slug}`}>
  <Card tilt={tilt} pin="left" tape={['tr']} tapeColor={tapeColor}>
    {
      project.media && (
        <img
          src={project.media.poster}
          alt={project.media.alt}
          width={project.media.width}
          height={project.media.height}
          loading="lazy"
          decoding="async"
          style="width:100%;background:#e6dfce;"
        />
      )
    }
    <h3 class="project-title">{project.name}</h3>
    <p class="project-meta">{project.team} · {project.built}</p>
    <p style="margin-top:0.5rem;font-size:0.98rem;">{blurb}</p>
    <ul class="tags">
      {project.stack.slice(0, 4).map((tech) => <li class="tag">{tech}</li>)}
    </ul>
  </Card>
</a>

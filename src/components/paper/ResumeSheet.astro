---
/**
 * Résumé as a printed sheet under a paperclip (§9).
 *
 * Config-driven per §13: renders only when public/resume.pdf exists. Dylan drops
 * the file in and this appears everywhere at once, with no code change. When it's
 * absent nothing is rendered — no dead button, no "coming soon". The page is
 * designed to look complete without it, because right now it is absent.
 *
 * This card is a TEASER, not the viewer. Its primary action goes to /resume
 * (src/pages/resume.astro), which is where the document is actually rendered;
 * nothing embeds a PDF here. Two reasons: this sits in a 22rem column on the home
 * page and inside the about page's photo row, neither of which has room for a
 * legible page of A4, and an <object> in both places would make every visitor to
 * / and /about fetch the PDF whether they wanted it or not.
 *
 * No page count, no file size, no "one page". The document does not exist yet, so
 * anything describing its shape is invented (R5) — and the y2k copy used to
 * disagree with this file about it, which is how you find out the claim was never
 * knowable in the first place.
 */
import { getResume } from '../../lib/resume';

const resume = getResume();
---

{
  resume.available && (
    <div class="card card--tilt-c" style="max-width:22rem;" data-print-block>
      <span class="clip" data-decorative aria-hidden="true" />
      <p class="hand" style="font-size:1.35rem;margin-bottom:0.2rem;">résumé</p>
      <p class="typewriter" style="color:var(--text-soft);">
        PDF · read it in the page or take it with you
      </p>
      <p style="margin-top:0.9rem;display:flex;gap:0.6rem;flex-wrap:wrap;">
        <a class="btn btn--primary" href={resume.page}>Read it →</a>
        <a class="btn" href={resume.href} download={resume.filename}>
          Download ↓
        </a>
      </p>
    </div>
  )
}

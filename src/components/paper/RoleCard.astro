---
/**
 * A role on the timeline. Renders the fact layer's bullets verbatim.
 *
 * §2 keeps experience bullets shared across all three themes on purpose, so this
 * component must not rephrase, summarize, or truncate them. Apple has a single
 * description field instead of bullets, and that field is the entire extent of
 * what may be said about Apple (R3).
 *
 * §13: Apple gets a text treatment, never the Apple logo — so `logo` is null on
 * that role and this component simply renders no image.
 */
import Card from './Card.astro';
import type { Role } from '../../data/types';

type Props = { role: Role; tilt?: 'a' | 'b' | 'c' };
const { role, tilt = 'a' } = Astro.props;
---

<Card tilt={tilt} pin="left" halftone={role.current ? 'butter' : false}>
  <div style="display:flex;flex-wrap:wrap;gap:0.5rem 1rem;align-items:baseline;">
    <h3 style="font-size:1.35rem;font-weight:600;">{role.title}</h3>
    <span class="sketch-date" style="margin-left:auto;">{role.datesShort}</span>
  </div>

  <p class="typewriter" style="margin-top:0.15rem;">
    <strong style="font-size:1.02rem;">{role.company}</strong>
    · {role.location} · {role.arrangement}
    {role.current && <span class="annotation" style="margin-left:0.5rem;">← now</span>}
  </p>

  <hr class="stitch" style="margin:0.9rem 0;" data-decorative />

  {role.description && <p>{role.description}</p>}

  {
    role.bullets.length > 0 && (
      <ul style="margin:0;padding-left:1.15rem;display:grid;gap:0.5rem;">
        {role.bullets.map((bullet) => (
          <li style="line-height:1.6;">{bullet}</li>
        ))}
      </ul>
    )
  }

  {
    role.note && (
      <p class="annotation" style="margin-top:0.9rem;display:block;transform:rotate(-0.6deg);">
        {role.note}
      </p>
    )
  }

  <ul class="tags">
    {role.tags.map((tech) => <li class="tag">{tech}</li>)}
  </ul>
</Card>

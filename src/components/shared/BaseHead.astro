---
/**
 * Document head: per-route metadata, social preview, structured data, and the
 * pre-paint theme script (spec §13).
 *
 * Every route passes its own title and description — a single site-wide pair
 * would waste the one piece of SEO that actually matters for a recruiter
 * searching a name.
 */
import { SITE, SITE_URL } from '../../config';
import { CANONICAL } from '../../data/voice';
import { EDUCATION } from '../../data/education';
import { IDENTITY, PHOTO, SOCIALS } from '../../data/identity';
import { ROLES } from '../../data/experience';
import { NO_FLASH_SCRIPT } from '../../lib/theme';
import { FEATURES } from '../../config';

type Props = {
  title: string;
  description?: string;
  /** Path only, e.g. "/projects/tanks". Canonical URL is derived from it. */
  path?: string;
  /** Overrides the social preview image; defaults to the paper-theme OG (§9). */
  ogImage?: string;
  /** Set on the chat route, which is a single-route app rather than a document. */
  noIndex?: boolean;
};

const {
  title,
  description = CANONICAL.metaDescription,
  path = Astro.url.pathname,
  ogImage = SITE.ogImage,
  noIndex = false,
} = Astro.props;

const canonical = new URL(path, SITE_URL).href;
const ogImageUrl = new URL(ogImage, SITE_URL).href;

const currentRole = ROLES.find((r) => r.current);

/**
 * Person structured data. The audience is recruiters, so it earns its keep (§13).
 * Every field traces to the fact layer — no invented awards, no metrics, and
 * `alumniOf` carries the 2028 completion date rather than a graduation claim.
 */
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: IDENTITY.name,
  url: SITE_URL,
  image: new URL(PHOTO.src, SITE_URL).href,
  email: `mailto:${IDENTITY.email}`,
  jobTitle: currentRole?.title,
  description: CANONICAL.bioShort,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Waterloo',
    addressRegion: 'ON',
    addressCountry: 'CA',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: EDUCATION.school,
    sameAs: 'https://uwaterloo.ca/',
  },
  ...(currentRole ? { worksFor: { '@type': 'Organization', name: currentRole.company } } : {}),
  sameAs: [SOCIALS.linkedin, SOCIALS.github],
  knowsAbout: [
    'Full-stack development',
    'Large language model evaluation',
    'Retrieval-augmented generation',
    'Python',
    'TypeScript',
    'React',
    'Django',
  ],
  seeks: {
    '@type': 'Demand',
    name: IDENTITY.availability,
  },
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noIndex && <meta name="robots" content="noindex, follow" />}

<meta name="author" content={IDENTITY.name} />
<meta name="generator" content={Astro.generator} />

{/* Favicon set generated by scripts/optimize-assets.sh from the 1.5 MB original.
    One framing at every size, so no per-size art direction to keep in sync. */}
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<meta property="og:type" content="profile" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:alt" content={`${IDENTITY.name} — ${IDENTITY.headline}`} />
<meta property="og:site_name" content={IDENTITY.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="profile:first_name" content="Dylan" />
<meta property="profile:last_name" content="Nagel" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<link rel="sitemap" href="/sitemap-index.xml" />

<script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />

{/* Applies the persisted theme/mode before first paint so there is no flash. */}
<script is:inline set:html={NO_FLASH_SCRIPT} />

{/*
  Suppresses the flash of paper before a client theme mounts.

  Paper is server-rendered, so it is in the HTML and paints immediately. Y2K and
  chat mount from a module script, which by definition runs AFTER first paint — so
  a visitor with Y2K persisted saw a frame or two of the corkboard before the
  desktop replaced it.

  This has to be CSS rather than more JS: the pre-paint script above has already
  written data-theme onto <html> by this point, so the rule below matches during
  the very first style resolution and paper never paints at all. Doing it in JS
  would just move the race, not win it.

  It is `is:inline` so it cannot depend on stylesheet ordering or on the dev
  server's injection timing.

  The background colours matter for the same reason: without them the gap between
  paint and mount is a white flash, which against the black CRT desktop is worse
  than the paper flash being removed here.

  The two `data-theme='chat'` rules are inert while that theme is hidden — the
  attribute can no longer take that value (see THEMES in src/config.ts). They stay
  because they are ~90 bytes of dead selector, and because leaving them means
  un-hiding the theme does not also require remembering to restore its
  flash-suppression. Do not "clean them up" without reading that comment first.
*/}
<style is:inline>
  html[data-theme='y2k'] #paper-root,
  html[data-theme='chat'] #paper-root {
    display: none;
  }

  html[data-theme='y2k'] {
    background: #008080;
  }
  html[data-theme='y2k'][data-mode='dark'] {
    background: #000;
  }
  html[data-theme='chat'] {
    background: #fff;
  }
  html[data-theme='chat'][data-mode='dark'] {
    background: #101418;
  }
</style>

{
  /*
   * ANALYTICS INSERTION POINT (§18.4).
   * Cloudflare Web Analytics goes here once the account exists — a single
   * beacon script tag, no cookie banner needed. Deliberately omitted rather
   * than stubbed: a dead analytics tag is worse than none.
   * Gate it on FEATURES.analytics in src/config.ts.
   */
  FEATURES.analytics && null
}

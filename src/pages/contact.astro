---
/**
 * /contact — form, direct email, socials, availability (wireframe §19.5, right).
 *
 * The mailto link is given equal billing with the form on purpose: in Phase A the
 * form is not connected, and email is the path that actually works.
 */
import PaperLayout from '../components/paper/PaperLayout.astro';
import Card from '../components/paper/Card.astro';
import ContactForm from '../components/paper/ContactForm.tsx';
import { IDENTITY, SOCIALS } from '../data/identity';
import { VOICES } from '../data/voice';

const voice = VOICES.paper;
---

<PaperLayout
  title={`Contact — ${IDENTITY.name}`}
  description={`Get in touch with Dylan Nagel. ${IDENTITY.availability}.`}
  path="/contact"
>
  <div class="cork">
    <div class="wrap board">
      <p class="lettered"><span aria-hidden="true">✎</span> {voice.headings.contact}</p>

      <div class="grid" style="margin-top:1.6rem;">
        <div class="col-7">
          <Card tilt="a" pin="center" tape={['bl']} tapeColor="butter">
            <p class="hand" style="font-size:1.4rem;margin-bottom:0.9rem;">
              <span aria-hidden="true">✉</span> send me a note
            </p>
            <ContactForm client:load />
          </Card>
        </div>

        <div class="col-5">
          <Card tilt="b" pin="right" halftone="sage">
            <p class="hand" style="font-size:1.4rem;">or just email me</p>
            <p style="margin-top:0.5rem;font-size:1.1rem;">
              <a href={`mailto:${IDENTITY.email}`}>{IDENTITY.email}</a>
            </p>

            <hr class="stitch" style="margin:1.3rem 0;" data-decorative />

            <p class="hand" style="font-size:1.3rem;">
              <span aria-hidden="true">▸</span>
              <span class="highlight">{IDENTITY.availability}</span>
            </p>

            <p style="margin-top:1.4rem;display:flex;gap:0.7rem;flex-wrap:wrap;">
              <a class="btn" href={SOCIALS.linkedin} rel="me noopener">LinkedIn ↗</a>
              <a class="btn" href={SOCIALS.github} rel="me noopener">GitHub ↗</a>
            </p>

            <p class="typewriter" style="margin-top:1.4rem;color:var(--text-soft);">
              Based in {IDENTITY.location}.
            </p>
          </Card>
        </div>
      </div>
    </div>
  </div>
</PaperLayout>

---
/**
 * /experience — full timeline (wireframe §19.3).
 *
 * Every role renders its bullets verbatim from the fact layer, plus education.
 * Apple appears with its single approved description and no logo (R3, §13).
 */
import PaperLayout from '../components/paper/PaperLayout.astro';
import Card from '../components/paper/Card.astro';
import RoleCard from '../components/paper/RoleCard.astro';
import { ROLES } from '../data/experience';
import { EDUCATION } from '../data/education';
import { IDENTITY } from '../data/identity';
import { VOICES } from '../data/voice';

const voice = VOICES.paper;
const tilts = ['a', 'b', 'c'] as const;
---

<PaperLayout
  title={`Experience — ${IDENTITY.name}`}
  description="Software developer intern at Apple; previously Carta and Empathia.ai. Four co-op terms across AI systems and full-stack product work."
  path="/experience"
>
  <div class="cork">
    <div class="wrap board">
      <p class="lettered"><span aria-hidden="true">✎</span> experience</p>
      <p class="hand on-desk" style="font-size:1.3rem;margin:0.4rem 0 2rem;">
        <span class="highlight highlight--sage">{IDENTITY.availabilityShort}</span>
      </p>

      <div style="display:grid;gap:2.2rem;max-width:64rem;">
        {ROLES.map((role, i) => <RoleCard role={role} tilt={tilts[i % tilts.length]} />)}

        <!-- Education sits on the same timeline (§8 route table). -->
        <Card tilt="b" pin="left" halftone="sky">
          <div style="display:flex;flex-wrap:wrap;gap:0.5rem 1rem;align-items:baseline;">
            <h3 style="font-size:1.35rem;font-weight:600;">{EDUCATION.degree}</h3>
            <span class="sketch-date" style="margin-left:auto;">{EDUCATION.dates}</span>
          </div>
          <p class="typewriter" style="margin-top:0.15rem;">
            <strong style="font-size:1.02rem;">{EDUCATION.school}</strong>
            · {EDUCATION.program} · {EDUCATION.location}
          </p>
          <hr class="stitch" style="margin:0.9rem 0;" data-decorative />
          <p>Cumulative GPA <strong>{EDUCATION.gpa}</strong></p>
          <p style="margin-top:0.6rem;">
            <span class="hand" style="font-size:1.2rem;">coursework:</span>
            {' '}{EDUCATION.coursework.join(' · ')}
          </p>
        </Card>
      </div>

      <p style="margin-top:2.5rem;">
        <a class="btn" href="/projects">{voice.ctaPrimary} →</a>
      </p>
    </div>
  </div>
</PaperLayout>

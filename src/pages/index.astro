---
import Layout from '../layouts/Layout.astro';
import Desktop from '../components/y2k/App';
import { getResume } from '../lib/resume';
import { IDENTITY, SOCIALS } from '../data';
import { CANONICAL } from '../data/copy';

/*
 * Resolved at build time: the client island can't check the filesystem, so it
 * gets the answer plus every href it might need.
 */
const resume = getResume();
---

<Layout>
  <div id="main">
    <Desktop client:only="react" resume={resume} />

    {/*
      The desktop is a window manager, so it needs JS. This is what is left
      without it: the same facts, no chrome. Worth having — it is also what a
      crawler that does not run scripts reads.
    */}
    <noscript>
      <div class="noscript">
        <h1>{IDENTITY.name}</h1>
        <p><strong>{IDENTITY.headline}</strong> · {IDENTITY.location}</p>
        <p>{IDENTITY.availability}.</p>
        <p>{CANONICAL.bioShort}</p>
        <ul>
          <li><a href={`mailto:${IDENTITY.email}`}>{IDENTITY.email}</a></li>
          <li><a href={SOCIALS.github}>GitHub</a></li>
          <li><a href={SOCIALS.linkedin}>LinkedIn</a></li>
          {resume.available && <li><a href={resume.href}>Résumé (PDF)</a></li>}
        </ul>
        <p>The rest of this site is a Windows 98 desktop, and it needs JavaScript.</p>
      </div>
    </noscript>
  </div>
</Layout>

<style>
  .noscript {
    max-width: 42rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
    font-family: Tahoma, Verdana, sans-serif;
    font-size: 15px;
    line-height: 1.55;
    color: #000;
    background: #c0c0c0;
    border: 2px solid #fff;
    box-shadow: inset -2px -2px 0 #808080;
  }

  .noscript h1 {
    font-size: 1.7rem;
    margin-bottom: 0.4rem;
  }

  .noscript p {
    margin: 0.7rem 0;
  }

  .noscript ul {
    margin: 0.7rem 0;
    padding-left: 1.2rem;
  }
</style>

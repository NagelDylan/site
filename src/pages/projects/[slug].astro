---
/**
 * /projects/:slug — detail pages (wireframe §19.4, right panel).
 *
 * Page-turn transition applies here and ONLY here (§9): a page-turn on the
 * primary scroll would fight reading, but between project pages it's the reward.
 *
 * Two rules land on this page:
 *   R2 — FlowSense's `framing` field ("Built at Hack the 6ix 2024.") is the
 *        ceiling of what may be said about how it did. No placement, no award.
 *   §5 — Acronymize's live demo is ABSENT rather than disabled: the button is
 *        rendered from the links array, so it simply doesn't exist until Dylan
 *        deploys and adds it.
 */
import PaperLayout from '../../components/paper/PaperLayout.astro';
import Card from '../../components/paper/Card.astro';
import ProjectMedia from '../../components/paper/ProjectMedia.tsx';
import { FEATURED } from '../../data/projects';
import { IDENTITY } from '../../data/identity';
import { VOICES } from '../../data/voice';

export function getStaticPaths() {
  return FEATURED.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      // Page-turn target: the next project, wrapping around. The `?? project`
      // is only there to satisfy noUncheckedIndexedAccess — the modulo makes the
      // index always in range for a non-empty list.
      next: FEATURED[(index + 1) % FEATURED.length] ?? project,
    },
  }));
}

const { project, next } = Astro.props;
const voice = VOICES.paper;
const blurb = voice.projectBlurbs[project.slug as keyof typeof voice.projectBlurbs];
---

<PaperLayout
  title={`${project.name} — ${IDENTITY.name}`}
  description={project.summary}
  path={`/projects/${project.slug}`}
  pageTurn
>
  <div class="cork">
    <div class="wrap board">
      <p style="margin-bottom:1.2rem;">
        <a class="hand on-desk" href="/projects" style="font-size:1.2rem;">← back to projects</a>
      </p>

      <div class="grid">
        <div class="col-6">
          {
            project.media && (
              <ProjectMedia
                animated={project.media.animated}
                poster={project.media.poster}
                alt={project.media.alt}
                width={project.media.width}
                height={project.media.height}
                client:visible
              />
            )
          }
        </div>

        <div class="col-6">
          <Card tilt="b" pin="left" tape={['br']} tapeColor="sage">
            <p class="lettered" style="font-size:2.2rem;letter-spacing:0.08em;">{project.name}</p>
            <p class="typewriter" style="margin-top:0.5rem;color:var(--text-soft);">
              {project.built} · {project.team}
            </p>
            <hr class="stitch" style="margin:1rem 0;" data-decorative />
            <p class="lede">{project.summary}</p>
            <p style="margin-top:0.9rem;">{blurb}</p>

            {
              project.framing && (
                <p class="annotation" style="display:block;margin-top:1rem;">
                  {project.framing}
                </p>
              )
            }

            <ul class="tags">
              {project.stack.map((tech) => <li class="tag">{tech}</li>)}
            </ul>

            <p style="margin-top:1.3rem;display:flex;gap:0.7rem;flex-wrap:wrap;">
              {
                project.links.map((link, i) => (
                  <a class={`btn ${i === 0 ? 'btn--primary' : ''}`} href={link.href} rel="noopener">
                    {link.label} ↗
                  </a>
                ))
              }
            </p>
          </Card>
        </div>

        <div class="col-12" style="margin-top:2.2rem;">
          <Card tilt="c" pin="right" halftone="butter">
            <p class="hand" style="font-size:1.5rem;">
              <span aria-hidden="true">✎</span> how it works
            </p>
            <ul style="margin:0.8rem 0 0;padding-left:1.15rem;display:grid;gap:0.6rem;">
              {project.highlights.map((item) => <li style="line-height:1.65;">{item}</li>)}
            </ul>
          </Card>
        </div>
      </div>

      <p style="margin-top:2.5rem;text-align:right;">
        <a class="btn" href={`/projects/${next.slug}`}>{next.name} →</a>
      </p>
    </div>
  </div>
</PaperLayout>

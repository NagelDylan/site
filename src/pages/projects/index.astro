---
/**
 * /projects — featured + secondary (wireframe §19.4, left panel).
 *
 * Secondary links carry a `verified` flag from the fact layer. The six repo URLs
 * were inferred rather than given verbatim in the spec, and no outbound link on
 * this site has been confirmed live yet (spec Appendix) — `npm run audit:links`
 * prints the checklist for the launch pass.
 */
import PaperLayout from '../../components/paper/PaperLayout.astro';
import Card from '../../components/paper/Card.astro';
import ProjectCard from '../../components/paper/ProjectCard.astro';
import { FEATURED, SECONDARY } from '../../data/projects';
import { IDENTITY } from '../../data/identity';
import { VOICES } from '../../data/voice';

const voice = VOICES.paper;
const tilts = ['a', 'b', 'c'] as const;
const tapes = ['butter', 'sage', 'blush'] as const;
---

<PaperLayout
  title={`Projects — ${IDENTITY.name}`}
  description="Acronymize, FlowSense, and a from-scratch recreation of Wii Play's Tanks, plus earlier game and web projects."
  path="/projects"
>
  <div class="cork">
    <div class="wrap board">
      <p class="lettered"><span aria-hidden="true">✎</span> projects</p>

      <p class="hand on-desk" style="font-size:1.35rem;margin:1.6rem 0 1rem;">
        <span class="highlight">featured</span>
      </p>

      <div class="grid">
        {
          FEATURED.map((project, i) => (
            <div class="col-4">
              <ProjectCard
                project={project}
                blurb={voice.projectBlurbs[project.slug as keyof typeof voice.projectBlurbs]}
                tilt={tilts[i % tilts.length]}
                tapeColor={tapes[i % tapes.length]}
              />
            </div>
          ))
        }
      </div>

      <p class="hand on-desk" style="font-size:1.35rem;margin:3rem 0 1rem;">
        <span aria-hidden="true">✎</span> <span class="highlight highlight--sage">also made</span>
      </p>

      <div class="grid">
        {
          SECONDARY.map((project, i) => (
            <div class="col-6">
              <Card tilt={tilts[(i + 1) % tilts.length]} pin={i % 2 === 0 ? 'left' : 'right'}>
                <h3 class="hand" style="font-size:1.45rem;">{project.name}</h3>
                <p style="margin-top:0.3rem;">{project.oneLiner}</p>
                <ul class="tags">
                  {project.stack.map((tech) => <li class="tag">{tech}</li>)}
                </ul>
                <p style="margin-top:0.9rem;display:flex;gap:0.9rem;flex-wrap:wrap;">
                  {
                    project.links.map((link) => (
                      <a href={link.href} rel="noopener">
                        {link.label} ↗
                      </a>
                    ))
                  }
                </p>
              </Card>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</PaperLayout>

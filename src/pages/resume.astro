---
/**
 * /resume — the canonical résumé viewer (§13, G7).
 *
 * G7 means four themes over one set of URLs, so this route is the shared
 * destination: paper renders the document here as a full page, while y2k and mac
 * resolve the same path to their own Résumé window. This file is the paper half.
 *
 * The file itself is the switch, exactly as everywhere else — getResume() runs at
 * build time and the page has two complete states. UNAVAILABLE is today's
 * reality and is not a placeholder: it is a real page that says plainly there is
 * no PDF posted and points at the routes that do carry the same information
 * (§18.5 — nothing may pretend to work, so no "coming soon", no disabled button,
 * and no link to a file that isn't there).
 *
 * The route exists in both states on purpose. The paper nav only links here when
 * the PDF does, but a deep link, a bookmark, or a y2k visitor who switched themes
 * mid-visit can all land on /resume regardless, and a 404 would be a worse
 * answer than an honest empty state. The empty state carries noindex so it never
 * becomes the search result for Dylan's name plus "resume".
 */
import PaperLayout from '../components/paper/PaperLayout.astro';
import Card from '../components/paper/Card.astro';
import { getResume } from '../lib/resume';
import { IDENTITY } from '../data/identity';
import { SITE_URL } from '../config';

const resume = getResume();

/**
 * Absolute URL, used ONLY by the print-only line at the bottom. A printed page
 * has no clickable links, so a relative href is worthless on paper — and
 * print.css only spells out destinations for http and mailto hrefs, so this has
 * to be a full URL to survive the trip to the printer.
 */
const pdfUrl = new URL(resume.href, SITE_URL).href;

const title = `Résumé — ${IDENTITY.name}`;
const description = resume.available
  ? `Read Dylan Nagel's résumé in the page or download the PDF. ${IDENTITY.headline}. ${IDENTITY.availability}.`
  : `Dylan Nagel's résumé is not posted as a PDF here. His full experience, projects and contact details are on the site, and a copy can be sent on request.`;
---

<PaperLayout {title} {description} path={resume.page} noIndex={!resume.available}>
  <div class="cork">
    <div class="wrap board">
      <p class="lettered"><span aria-hidden="true">✎</span> résumé</p>

      <div class="resume-page">
        {
          resume.available ? (
            <Fragment>
              <Card tilt="a" pin="left" tape={['tr']} tapeColor="butter">
                <h1 class="display">{IDENTITY.name}</h1>
                <p class="hand" style="font-size:1.5rem;margin-top:0.2rem;">
                  {IDENTITY.headline}
                </p>
                <p class="hand" style="font-size:1.3rem;margin-top:0.7rem;">
                  <span aria-hidden="true">▸</span>
                  <span class="highlight highlight--sage">{IDENTITY.availability}</span>
                </p>
                <hr class="stitch" style="margin:1.2rem 0;" data-decorative />
                <p class="lede">
                  Here it is in the page, so you can read it without downloading
                  anything — and the file is one click away if you'd rather have it.
                </p>
                {/*
                  The actions sit ABOVE the embed, not under it. A recruiter with the
                  tab open for ten seconds should not have to scroll a full page of PDF
                  to find the download — which is exactly what happens when the buttons
                  live below the viewer.
                */}
                <p style="margin-top:1.4rem;display:flex;gap:0.75rem;flex-wrap:wrap;">
                  <a class="btn btn--primary" href={resume.href} download={resume.filename}>
                    Download PDF ↓
                  </a>
                  <a
                    class="btn"
                    href={resume.href}
                    target="_blank"
                    rel="noreferrer noopener"
                  >
                    Open in a new tab ↗
                  </a>
                </p>
              </Card>

              {/*
                The document itself, dressed as a sheet under the paperclip so it
                reads as one more thing pinned to the board.

                Flat, unlike every other card here — .resume-sheet pins --tilt to 0
                and the note there explains why a rotated PDF is unreadable rather
                than charming.
              */}
              <Card tilt="flat" pin="none" class="resume-sheet">
                <span class="clip" data-decorative aria-hidden="true" />

                {/*
                  <object> rather than <iframe> on purpose: its children render as
                  real fallback when there is no inline PDF viewer, whereas an iframe
                  that cannot render the file just shows blank and says nothing.
                  aria-label is not optional — an unlabelled embedded object is a
                  nameless "embedded object" node to a screen reader.
                */}
                <object
                  class="resume-embed"
                  type="application/pdf"
                  data={resume.viewHref}
                  aria-label={`${IDENTITY.name}'s résumé (PDF)`}
                >
                  <div class="resume-embed-fallback">
                    <p>
                      This browser cannot display PDFs inside a page, so here is the
                      file itself.
                    </p>
                    <p style="margin-top:1rem;display:flex;gap:0.75rem;flex-wrap:wrap;">
                      <a class="btn btn--primary" href={resume.href} download={resume.filename}>
                        Download PDF ↓
                      </a>
                      <a
                        class="btn"
                        href={resume.href}
                        target="_blank"
                        rel="noreferrer noopener"
                      >
                        Open in a new tab ↗
                      </a>
                    </p>
                  </div>
                </object>

                {/*
                  The narrow-viewport path. BOTH this and the <object> above are
                  always in the HTML and a media query in theme-paper.css shows
                  exactly one of them — no JavaScript and no user-agent sniffing, so
                  it survives paper's no-JS guarantee and cannot get the answer wrong
                  on a browser nobody tested.

                  It exists because phone browsers frequently refuse to render a PDF
                  inline at all: the <object> collapses to a dead grey rectangle, and
                  a dead grey rectangle where a document should be reads as a broken
                  site rather than as an unsupported feature. A link that plainly
                  works is better than a box that plainly doesn't.

                  data-print-hide because "open it in a new tab" means nothing on
                  paper; print.css strips it and prints the line below instead.
                */}
                <div class="resume-narrow" data-print-hide>
                  <p class="hand" style="font-size:1.35rem;">résumé</p>
                  <p style="margin-top:0.4rem;">
                    Your browser may not display PDFs inside a page — open it in a new
                    tab or download it instead.
                  </p>
                  <p style="margin-top:1.1rem;display:flex;gap:0.7rem;flex-wrap:wrap;">
                    <a
                      class="btn btn--primary"
                      href={resume.href}
                      target="_blank"
                      rel="noreferrer noopener"
                    >
                      Open the PDF ↗
                    </a>
                    <a class="btn" href={resume.href} download={resume.filename}>
                      Download ↓
                    </a>
                  </p>
                </div>

                {/*
                  Print (G15). An embedded PDF prints as a blank rectangle or as a
                  screenshot of somebody's viewer chrome, so print.css hides both
                  boxes above and reveals this line instead. Screen never sees it.
                */}
                <p class="typewriter" data-print-only>
                  Résumé — {resume.filename}, available at {pdfUrl}
                </p>
              </Card>
            </Fragment>
          ) : (
            <Card tilt="a" pin="left" tape={['tr']} tapeColor="blush">
              <h1 class="display">{IDENTITY.name}</h1>
              <p class="hand" style="font-size:1.5rem;margin-top:0.2rem;">
                {IDENTITY.headline}
              </p>
              <p class="hand" style="font-size:1.3rem;margin-top:0.7rem;">
                <span aria-hidden="true">▸</span>
                <span class="highlight highlight--sage">{IDENTITY.availability}</span>
              </p>

              <hr class="stitch" style="margin:1.3rem 0;" data-decorative />

              <p class="lede">
                There is no résumé PDF posted here. Rather than park a broken button on
                the page, here is where the same information actually lives:
              </p>

              <ul style="margin:1.1rem 0 0;padding-left:1.1rem;">
                <li>
                  <a href="/experience">Experience</a> — every role, with the work
                  written out rather than compressed to one line.
                </li>
                <li>
                  <a href="/projects">Projects</a> — what they are, what they're built
                  with, and the code.
                </li>
                <li>
                  <a href="/about">About</a> — the longer version, plus school and the
                  tools I use.
                </li>
              </ul>

              <p style="margin-top:1.2rem;">
                If you need a résumé in hand, email me at{' '}
                <a href={`mailto:${IDENTITY.email}`}>{IDENTITY.email}</a> and I'll send a
                copy directly.
              </p>

              <p style="margin-top:1.4rem;display:flex;gap:0.75rem;flex-wrap:wrap;">
                <a class="btn btn--primary" href="/experience">Read my experience →</a>
                <a class="btn" href="/contact">Get in touch</a>
              </p>

              <p class="typewriter" style="margin-top:1.5rem;color:var(--text-soft);">
                Based in {IDENTITY.location}.
              </p>
            </Card>
          )
        }
      </div>
    </div>
  </div>
</PaperLayout>
